__pycache__/
*.pyc
.venv/
.pytest_cache/
build/
dist/
install/
log/
.robotbase/
*.egg-info/
.superpowers/

# robotbench: generated ROS project trees are scratch, never tracked;
# results/*.json (trial evidence records) stay committable.
/rbench-projects-*/
robotbase/robotbench/results/*.mcap
.robotbench_key
.robotbench_env
_rbench_pilot.py
_rbench_run.py
robotbase/robotbench/results/transcripts/
_regen.py
_dogfood_refs.py
robotbase/robotbench/results/runs/

# Templates commit source only (robot.yaml/world.yaml + package skeleton + controller +
# scenarios); the compiler generates URDF/SDF/launch/bridges from the specs on `robotbase create`.
robotbase/templates/*/src/*/urdf/*.urdf.xacro
robotbase/templates/*/src/*/urdf/*.imported.urdf
robotbase/templates/*/src/*/urdf/bridges.json
robotbase/templates/*/src/*/urdf/launch_config.json
robotbase/templates/*/src/*/worlds/*.sdf
robotbase/templates/*/src/*/launch/*.launch.py

# Internal docs (strategy / vision / roadmap / design / results) are kept local — not published.
# Only README.md is public; a GitHub-specific doc can be crafted later.
docs/
/PROOF.md
/CONTRIBUTING.md

# Local-only — kept out of the public repo.
/spike/                              # throwaway early-exploration spike
/_rbench_run_v2.py                   # scratch RobotBench batch runner (local; used for n=N runs)
robotbase/robotbench/results/*.json  # n=1 trial evidence — held back until a full n=3 run
