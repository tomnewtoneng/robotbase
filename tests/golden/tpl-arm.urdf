<?xml version="1.0"?>
<!-- Generated by Robotbase from robot.yaml — edit the spec, not this file. -->
<robot name="warehouse_bot" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="world"/>
  <link name="arm_base_link">
    <inertial><mass value="10"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
    <collision><geometry><cylinder radius="0.07" length="0.1"/></geometry></collision>
    <visual><geometry><cylinder radius="0.07" length="0.1"/></geometry><material name="arm_base"><color rgba="0.25 0.25 0.30 1"/></material></visual>
  </link>
  <link name="upper_arm">
    <inertial><origin xyz="0 0 0.2"/><mass value="0.15"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0002"/></inertial>
    <collision><origin xyz="0 0 0.2"/><geometry><cylinder radius="0.035" length="0.4"/></geometry></collision>
    <visual><origin xyz="0 0 0.2"/><geometry><cylinder radius="0.035" length="0.4"/></geometry><material name="upper_arm_mat"><color rgba="0.2 0.5 0.8 1"/></material></visual>
  </link>
  <link name="forearm">
    <inertial><origin xyz="0 0 0.2"/><mass value="0.15"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0002"/></inertial>
    <collision><origin xyz="0 0 0.2"/><geometry><cylinder radius="0.035" length="0.4"/></geometry></collision>
    <visual><origin xyz="0 0 0.2"/><geometry><cylinder radius="0.035" length="0.4"/></geometry><material name="forearm_mat"><color rgba="0.2 0.7 0.5 1"/></material></visual>
  </link>
  <link name="tip"/>
  <joint name="arm_fixed_base" type="fixed"><parent link="world"/><child link="arm_base_link"/><origin xyz="0 0 0.05"/></joint>
  <joint name="shoulder_joint" type="revolute"><parent link="arm_base_link"/><child link="upper_arm"/><origin xyz="0 0 0.05"/><axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="100" velocity="3.0"/></joint>
  <joint name="elbow_joint" type="revolute"><parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 0.4"/><axis xyz="0 1 0"/><limit lower="-3.14" upper="3.14" effort="100" velocity="3.0"/></joint>
  <joint name="tip_joint" type="fixed"><parent link="forearm"/><child link="tip"/><origin xyz="0 0 0.4"/></joint>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_joint</joint_name><topic>shoulder_cmd</topic>
      <p_gain>80</p_gain><i_gain>2.0</i_gain><d_gain>8.0</d_gain></plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_joint</joint_name><topic>elbow_cmd</topic>
      <p_gain>60</p_gain><i_gain>2.0</i_gain><d_gain>6.0</d_gain></plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic></plugin></gazebo>
</robot>
