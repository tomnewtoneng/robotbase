    <visual><geometry><cylinder radius="0.05" length="0.01"/></geometry><material name="rotor_br_m"><color rgba="0.2 0.2 0.2 1"/></material></visual>
  </link>
  <link name="imu_link"/>
  <joint name="rotor_fl_joint" type="fixed"><parent link="base_link"/><child link="rotor_fl"/><origin xyz="0.18 0.18 0.04"/></joint>
  <joint name="rotor_fr_joint" type="fixed"><parent link="base_link"/><child link="rotor_fr"/><origin xyz="0.18 -0.18 0.04"/></joint>
  <joint name="rotor_bl_joint" type="fixed"><parent link="base_link"/><child link="rotor_bl"/><origin xyz="-0.18 0.18 0.04"/></joint>
