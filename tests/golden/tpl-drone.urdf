      <dimensions>3</dimensions><odom_topic>odom</odom_topic><tf_topic>tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency></plugin></gazebo>
  <gazebo reference="imu_link"><sensor name="imu" type="imu"><topic>imu</topic><gz_frame_id>imu_link</gz_frame_id><update_rate>50</update_rate><always_on>true</always_on></sensor></gazebo>
