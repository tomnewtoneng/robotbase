    <inertial><mass value="1"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.04"/></inertial>
    <collision><geometry><box size="0.16 0.16 0.06"/></geometry></collision>
    <visual><geometry><box size="0.16 0.16 0.06"/></geometry><material name="body"><color rgba="0.2 0.2 0.25 1"/></material></visual>
  </link>
  <link name="rotor_fl">
    <inertial><mass value="0.02"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
    <visual><geometry><cylinder radius="0.05" length="0.01"/></geometry><material name="rotor_fl_m"><color rgba="0.9 0.2 0.2 1"/></material></visual>
  </link>
  <link name="rotor_fr">
    <inertial><mass value="0.02"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
    <visual><geometry><cylinder radius="0.05" length="0.01"/></geometry><material name="rotor_fr_m"><color rgba="0.2 0.2 0.2 1"/></material></visual>
  </link>
  <link name="rotor_bl">
    <inertial><mass value="0.02"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
    <visual><geometry><cylinder radius="0.05" length="0.01"/></geometry><material name="rotor_bl_m"><color rgba="0.2 0.2 0.2 1"/></material></visual>
  </link>
  <link name="rotor_br">
