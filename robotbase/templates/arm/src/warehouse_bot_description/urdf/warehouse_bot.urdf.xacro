<?xml version="1.0"?>
<!-- A fixed-base 2-DOF arm (shoulder + elbow, both pitching about y so the arm moves in
     the x-z plane). Anchored to the world via a link named "world" (gz treats it as the
     global frame). Each joint has a gz JointPositionController driven by a command topic;
     joint angles are published on /joint_states. This is the "arm" Robotbase template. -->
<robot name="warehouse_bot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="link_len" value="0.40"/>
  <xacro:property name="link_rad" value="0.035"/>

  <!-- Anchor the base to the world frame. -->
  <link name="world"/>

  <link name="base_link">
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
    <collision><geometry><cylinder radius="0.07" length="0.10"/></geometry></collision>
    <visual>
      <geometry><cylinder radius="0.07" length="0.10"/></geometry>
      <material name="base"><color rgba="0.25 0.25 0.30 1"/></material>
    </visual>
  </link>
  <joint name="fixed_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05"/>
  </joint>

  <!-- A link is a cylinder along its local +z, with the joint at its base (z=0). -->
  <xacro:macro name="arm_link" params="name rgba">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 ${link_len/2}"/>
        <mass value="0.15"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0002"/>
      </inertial>
      <collision>
        <origin xyz="0 0 ${link_len/2}"/>
        <geometry><cylinder radius="${link_rad}" length="${link_len}"/></geometry>
      </collision>
      <visual>
        <origin xyz="0 0 ${link_len/2}"/>
        <geometry><cylinder radius="${link_rad}" length="${link_len}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
    </link>
  </xacro:macro>

  <xacro:arm_link name="upper_arm" rgba="0.2 0.5 0.8 1"/>
  <xacro:arm_link name="forearm" rgba="0.2 0.7 0.5 1"/>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="3.0"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 ${link_len}"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="3.0"/>
  </joint>

  <!-- End-effector tip frame at the end of the forearm. -->
  <link name="tip"/>
  <joint name="tip_joint" type="fixed">
    <parent link="forearm"/>
    <child link="tip"/>
    <origin xyz="0 0 ${link_len}"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_joint</joint_name>
      <topic>shoulder_cmd</topic>
      <p_gain>80</p_gain><i_gain>2.0</i_gain><d_gain>8.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_joint</joint_name>
      <topic>elbow_cmd</topic>
      <p_gain>60</p_gain><i_gain>2.0</i_gain><d_gain>6.0</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
